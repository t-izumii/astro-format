{
  "name": "dev",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host",
    "build": "npm run clean && astro build",
    "clean": "rm -rf dist",
    "preview": "astro preview",
    "astro": "astro",
    "lint:css": "stylelint \"**/*.{css,scss}\"",
    "lint:css:fix": "stylelint \"**/*.{css,scss}\" --fix",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:html": "markuplint \"src/**/*.{html,astro}\" \"src/**/*.tsx\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.0",
    "@fluejs/noscroll": "^1.0.0",
    "@splidejs/splide": "^4.1.4",
    "astro": "^7.0.0",
    "gsap": "^3.14.2",
    "lil-gui": "^0.21.0",
    "preact": "^10.28.3",
    "throttle-debounce": "^5.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@markuplint/astro-parser": "^4.6.23",
    "@markuplint/jsx-parser": "^4.7.23",
    "@types/node": "^25.3.3",
    "@types/stats.js": "^0.17.4",
    "@types/throttle-debounce": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-astro": "^1.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markuplint": "^4.14.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "rolldown": "1.0.3",
    "sass": "^1.97.0",
    "sharp": "^0.34.5",
    "stats.js": "^0.17.0",
    "stylelint": "^17.0.0",
    "stylelint-config-recess-order": "^7.6.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3"
  }
}
