---
import Icon from "@/components/ui/icon";
---

<section class="p-catalog__section">
  <h2 class="p-catalog__title">Icon</h2>
  <div class="p-catalog__row p-catalog__row--middle">
    <span class="p-catalog__item"
      ><Icon name="arrow" /><small>既定値 1em</small></span
    >
    <span class="p-catalog__item"
      ><Icon name="arrow" style={{ "--size": "1.5rem" }} /><small>24px</small
      ></span
    >
    <span class="p-catalog__item"
      ><Icon
        name="arrow"
        style={{ "--size": "2.5rem", "--size-sp": "1.5rem" }}
      /><small>PC 40px / SP 24px</small></span
    >
    <span class="p-catalog__item"
      ><Icon
        name="arrow"
        style={{ "--width": "4rem", "--height": "4rem" }}
      /><small>64×64</small></span
    >
  </div>
</section>
