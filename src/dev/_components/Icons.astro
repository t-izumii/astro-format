  <div class="p-catalog__row p-catalog__row--middle">
    <span class="p-catalog__item">
      <Icon name="arrow" size={24} />
      <small>size=24</small>
    </span>
    <span class="p-catalog__item">
      <Icon name="arrow" size={40} />
      <small>size=40</small>
    </span>
    <span class="p-catalog__item">
      <Icon name="arrow" width={64} height={64} />
      <small>64×64</small>
    </span>
  </div>
</section>
