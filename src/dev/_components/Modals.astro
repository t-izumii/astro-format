---
import Modal from "@/components/ui/modal";
---

<section class="p-catalog__section">
  <h2 class="p-catalog__title">Modal</h2>
  <div class="p-catalog__row">
    <button type="button" data-modal-target="catalog-modal">
      モーダルを開く
    </button>
    <a href="#layout" data-scroll-to="#layout" data-scroll-duration="0.1"
      >レイアウト例へ移動</a
    >
  </div>

  <Modal data-modal-id="catalog-modal" aria-labelledby="catalog-modal-title">
    <h3 id="catalog-modal-title">カタログモーダル</h3>
    <p>プレビュー用のモーダルです。</p>
    <p>背景クリック / ESCキー / ×ボタン で閉じます。</p>
  </Modal>
</section>
