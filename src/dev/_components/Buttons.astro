---
import Button from "@/components/ui/button";
import ActionLink from "@/components/ui/link";
import Icon from "@/components/ui/icon";
---

<section class="p-catalog__section">
  <h2 class="p-catalog__title">Button / Link</h2>
  <div class="p-catalog__row">
    <Button>通常ボタン</Button>
    <ActionLink href="/">リンク (a)</ActionLink>
    <ActionLink href="https://example.com" target="_blank" rel="noopener"
      >新規タブ</ActionLink
    >
    <Button type="submit">submit</Button>
    <Button disabled>無効</Button>
    <Button><Icon name="arrow" />進む</Button>
    <Button class="p-catalog__customButton">クラスで上書き</Button>
  </div>
</section>

<style is:global>
  .p-catalog__customButton {
    --button-padding: 0.75rem 2rem;
    --button-background: #222;
    --button-color: #fff;
  }
</style>
