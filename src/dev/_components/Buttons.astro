---
import Button from "@/components/ui/button";
---

<section class="p-catalog__section">
  <h2 class="p-catalog__title">Button</h2>
  <div class="p-catalog__row">
    <Button label="通常ボタン" />
    <Button label="リンク (a)" href="/" />
    <Button
      label="新規タブ"
      href="https://example.com"
      target="_blank"
      rel="noopener"
    />
    <Button label="submit" type="submit" />
    <Button label="無効" disabled />
  </div>
</section>
