---
interface Source {
  srcset: string;
  media?: string;
  type?: string;
}

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  fetchpriority?: "high" | "low" | "auto";
  loading?: "lazy" | "eager";
  sources?: Source[];
  srcset?: string;
}

const {
  src,
  alt,
  width,
  height,
  class: className,
  fetchpriority,
  loading,
  sources,
  srcset,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL || "";
const fullSrc = src.startsWith("http") ? src : `${baseUrl}${src}`;
---

<picture>
  {sources?.map((source: Source) => (
    <source
      srcset={source.srcset.startsWith("http") ? source.srcset : `${baseUrl}${source.srcset}`}
      media={source.media}
      type={source.type}
    />
  ))}
  <img
    src={fullSrc}
    srcset={srcset}
    alt={alt}
    width={width}
    height={height}
    class={className}
    fetchpriority={fetchpriority as any}
    loading={loading}
  />
</picture>
